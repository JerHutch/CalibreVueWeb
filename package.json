{
  "name": "calibre-web-app",
  "version": "1.0.0",
  "description": "Web interface for Calibre eBook library",
  "scripts": {
    "setup": "bun install",
    "start": "concurrently \"bun run backend\" \"bun run frontend\"",
    "backend": "cd backend && bun run dev",
    "frontend": "cd frontend && bun run dev",
    "build": "concurrently \"cd backend && bun run build\" \"cd frontend && bun run build\"",
    "test": "concurrently \"cd backend && bun run test\" \"cd frontend && bun run test\""
  },
  "devDependencies": {
    "@faker-js/faker": "^9.7.0",
    "@types/express": "4.17.21",
    "concurrently": "^8.2.2"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "dependencies": {
    "@types/express-session": "^1.18.1",
    "express-session": "^1.18.1"
  },
  "overrides": {
    "@types/express": "4.17.21",
    "@types/express-serve-static-core": "4.19.6"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "esbuild"
  ]
}
