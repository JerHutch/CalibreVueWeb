DOCKERHUB_USER=your-docker-hub-user
DOCKERHUB_REPOSITORY=your-repository
FRONTEND_IMAGE_NAME=calibre-vue-frontend
BACKEND_IMAGE_NAME=calibre-vue-backend
# Build machine only: a Docker Hub personal access token for non-interactive
# push login. Leave empty if you have already run `docker login`. Deploy-only
# hosts pull from the public repository and do not need a token.
DOCKERHUB_TOKEN=
# Build machine: leave blank to use the Git SHA. Pull-only NAS: use `latest` to
# follow the stable aliases without changing this value for each release.
IMAGE_TAG=
DOCKER_PLATFORMS=linux/amd64
BUILDX_BUILDER=calibre-builder

FRONTEND_PORT=8888
BACKEND_PORT=3000
FRONTEND_URL=http://localhost:8888
SESSION_SECRET=replace-with-a-long-random-value
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Comma-separated Google emails that are made admin and approved on sign-in.
# Needed to bootstrap the first admin; leave empty afterwards if you prefer.
ADMIN_EMAILS=you@example.com
CALIBRE_DB_PATH=/absolute/path/to/calibre/library
CALIBRE_DB_NAME=metadata.db
APP_DB_PATH=/usr/src/app/data/app/app.db
PUID=1000
PGID=1000
TZ=UTC
LOG_RETENTION_DAYS=30
# Optional: number of proxies in front of the backend. Leave unset for the
# default (1 when FRONTEND_URL is https). Behind Synology Reverse Proxy plus the
# frontend nginx container use 2. Never set it higher than the real number of
# proxies: clients could then spoof their IP via X-Forwarded-For.
# TRUST_PROXY_HOPS=2
# Optional: browser log entries accepted per local day (default 20000).
# CLIENT_LOG_DAILY_LIMIT=20000
