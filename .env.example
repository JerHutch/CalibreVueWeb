DOCKERHUB_USER=your-docker-hub-user
DOCKERHUB_REPOSITORY=your-private-repository
FRONTEND_IMAGE_NAME=calibre-vue-frontend
BACKEND_IMAGE_NAME=calibre-vue-backend
# Use a Docker Hub personal access token for non-interactive login. Leave this
# empty if you have already run `docker login` on both build and deploy hosts.
DOCKERHUB_TOKEN=
# Build machine: leave blank to use the Git SHA. Pull-only NAS: use `latest` to
# follow the stable aliases without changing this value for each release.
IMAGE_TAG=
DOCKER_PLATFORMS=linux/amd64
BUILDX_BUILDER=calibre-builder

FRONTEND_PORT=8888
BACKEND_PORT=3000
FRONTEND_URL=http://localhost:8888
SESSION_SECRET=replace-with-a-long-random-value
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
CALIBRE_DB_PATH=/absolute/path/to/calibre/library
CALIBRE_DB_NAME=metadata.db
APP_DB_PATH=/usr/src/app/data/app/app.db
